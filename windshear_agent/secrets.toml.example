# Copy this file to .streamlit/secrets.toml and fill in ONE of the two modes.
# Never commit the real secrets.toml. On Streamlit Community Cloud, paste the
# same block into the app's Settings -> Secrets editor instead.

# ---------------------------------------------------------------------------
# Mode 1 (recommended): OAuth refresh token for your own My Drive.
# Create the token locally with:
#   python gdrive_setup.py --client-secrets client_secret_XXXX.json
# The app creates/reuses a "Himawari_9" folder and uses the drive.file scope.
# ---------------------------------------------------------------------------
[gdrive]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
refresh_token = "your-refresh-token"

# ---------------------------------------------------------------------------
# Mode 2 (alternative): service account with access to a shared folder.
# Share the destination folder with the service account's email as Editor.
# A Google Workspace Shared Drive is recommended; a personal My Drive folder
# may fail with storageQuotaExceeded because service accounts have no quota.
# Use either the JSON text or a path to the key file, plus the folder ID:
#
# [gdrive]
# service_account_json = """{ ... the whole service-account JSON ... }"""
# folder_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz"
# ---------------------------------------------------------------------------
